{
  "name": "nodewavenui",
  "version": "0.2.0",
  "description": "An Electron AI workspace UI",
  "license": "MIT",
  "author": "Marc-Andre Ferland",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "watch": "node scripts/copy-assets.mjs && tsc -b --watch",
    "clean": "node scripts/clean.mjs",
    "test": "npm run lint && npm run build && mocha dist/tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "npm run build && node scripts/check-electron-sandbox.mjs && electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "electron": "^45.2.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jasmine-core": "^7.0.2",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
